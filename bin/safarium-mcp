        "mimeType": "application/json",
    },
]


def _read_resource(uri):
    if uri == "safarium://docs/render-standard":
        p = _share_doc_path("render-standard.md")
        if p:
            return [{"uri": uri, "mimeType": "text/markdown", "text": open(p, encoding="utf-8").read()}]
        return [{"uri": uri, "mimeType": "text/markdown", "text": SERVER_INSTRUCTIONS}]
    if uri == "safarium://docs/project-video-rule":
        p = _share_doc_path("project-video-rule.md")
        if p:
            return [{"uri": uri, "mimeType": "text/markdown", "text": open(p, encoding="utf-8").read()}]
        return [{"uri": uri, "mimeType": "text/markdown", "text": SERVER_INSTRUCTIONS}]
    if uri == "safarium://docs/ai-control-protocol":
        p = _share_doc_path("ai-control-protocol.md")
        if p:
            return [{"uri": uri, "mimeType": "text/markdown", "text": open(p, encoding="utf-8").read()}]
        return [{"uri": uri, "mimeType": "text/markdown", "text": SERVER_INSTRUCTIONS}]
    if uri == "safarium://schema/all":
        exe = _require_render_bin()
        res = _run_subprocess(exe, ["schema", "all"], timeout_sec=15)
        return [{"uri": uri, "mimeType": "application/json", "text": res["stdout"].strip() or "{}"}]
    if uri == "safarium://status/live":
        exe = _require_render_bin()
        res = _run_subprocess(exe, ["status", "--json-detail"], timeout_sec=10)
        return [{"uri": uri, "mimeType": "application/json", "text": res["stdout"].strip() or "{}"}]
    return None


PROMPTS = [
    {
        "name": "preflight_check",
        "description": "Inspect Safarium environment health, hardware capabilities, and FIFO queue before rendering.",
        "arguments": [],
    },
    {
        "name": "render_and_verify",
        "description": "Step-by-step SF-VIDEO-1 render and zero-FFmpeg verification workflow.",
        "arguments": [
            {"name": "input_path", "description": "Input HTML or Forge recipe JSON path.", "required": True},
            {"name": "output_path", "description": "Destination MP4/MOV output path.", "required": True},
            {"name": "reference_path", "description": "Optional reference video path for parity verification.", "required": False},
        ],
    },
    {
        "name": "diagnose_render_failure",
        "description": "Diagnose a Safarium E_* error code and recommend concrete macOS Apple Silicon fixes.",
        "arguments": [
            {"name": "error_code", "description": "Safarium E_* error code (e.g. E_UNSUPPORTED_CODEC).", "required": True},
            {"name": "media_path", "description": "Optional failing input media path to probe.", "required": False},
        ],
    },
]


def _get_prompt(name, args):
    args = args or {}
    if name == "preflight_check":
        return {
            "description": "Preflight health & queue audit for Safarium.",
            "messages": [
                {
                    "role": "user",
                    "content": {
                        "type": "text",
                        "text": (
                            "Run `doctor`, `status`, and `capabilities` tools. Confirm `healthy: true`, "
                            "zero orphan workers, Apple-only linkage, and check whether the SF-VIDEO-1 "
                            "queue is idle before scheduling any heavy render."
                        ),
                    },
                }
            ],
        }
    if name == "render_and_verify":
        inp = args.get("input_path", "<input_path>")
        out = args.get("output_path", "<output_path>")
        ref = args.get("reference_path")
        ref_step = (
            f"Then run `verify_media` comparing `reference_path={ref}` against `candidate_path={out}`, "
            f"and `qa_inspect` with `ref_path={ref}`."
            if ref
            else f"Then run `verify_media` on `{out}` and `qa_inspect` on `{out}`."
        )
        return {
            "description": "Safe SF-VIDEO-1 render + verify workflow.",
            "messages": [
                {
                    "role": "user",
                    "content": {
                        "type": "text",
                        "text": (
                            f"1. Call `doctor` and `status`.\n"
                            f"2. If `{inp}` is a Forge recipe JSON, validate it with `forge_validate` first, then run `forge_run`.\n"
                            f"   If `{inp}` is HTML, render it via `html_render` to `{out}`.\n"
                            f"3. {ref_step}\n"
                            f"4. Report Peak RAM / duration / verification result honestly."
                        ),
                    },
                }
            ],
        }
    if name == "diagnose_render_failure":
        code = args.get("error_code", "E_UNKNOWN")
        media = args.get("media_path")
        probe_hint = f" Also run `probe_media` on `{media}`." if media else ""
        return {
            "description": "Diagnose Safarium structured error.",
            "messages": [
                {
                    "role": "user",
                    "content": {
                        "type": "text",
                        "text": (
                            f"Diagnose Safarium error `{code}`: call `forge_schema(target='errors')`, "
                            f"`doctor`, and `capabilities`.{probe_hint} Explain the root cause and "
                            f"exact fix without introducing FFmpeg, Chrome, or OpenCV."
                        ),
                    },
                }
            ],
        }
    return None


# ---------------------------------------------------------------------------
# JSON-RPC 2.0 Dispatcher
# ---------------------------------------------------------------------------

class MCPServer:
    def __init__(self):
        self.initialized = False
        self.negotiated_version = DEFAULT_NEGOTIATED_VERSION

    def _error(self, req_id, code, message, data=None):
        err = {"code": code, "message": message}
        if data is not None:
            err["data"] = data
        return {"jsonrpc": "2.0", "id": req_id, "error": err}

    def _result(self, req_id, result):
        return {"jsonrpc": "2.0", "id": req_id, "result": result}

    def handle_message(self, msg, *, in_batch=False):
        if not isinstance(msg, dict) or msg.get("jsonrpc") != "2.0":
            return self._error(None, -32600, "Invalid Request: expected JSON-RPC 2.0 object")
        method = msg.get("method")
        if not isinstance(method, str):
            return self._error(msg.get("id"), -32600, "Invalid Request: missing string 'method'")

        is_notification = "id" not in msg
        req_id = msg.get("id")
        params = msg.get("params")

        if method == "initialize":
            if in_batch:
                return self._error(req_id, -32600, "Invalid Request: 'initialize' cannot be batched")
            req_ver = params.get("protocolVersion") if isinstance(params, dict) else None
            if isinstance(req_ver, str) and req_ver in SUPPORTED_VERSIONS:
                self.negotiated_version = req_ver
            else:
                self.negotiated_version = DEFAULT_NEGOTIATED_VERSION
            return self._result(
                req_id,
                {
                    "protocolVersion": self.negotiated_version,
                    "capabilities": {
                        "tools": {"listChanged": False},
                        "resources": {"subscribe": False, "listChanged": False},
                        "prompts": {"listChanged": False},
                    },
                    "serverInfo": {
                        "name": SERVER_NAME,
                        "version": SERVER_VERSION,
                    },
                    "instructions": SERVER_INSTRUCTIONS,
                },
            )

        if method in ("notifications/initialized", "initialized"):
            self.initialized = True
            return None

        if method == "notifications/cancelled":
            return None

        if method == "ping":
            return None if is_notification else self._result(req_id, {})

        if method == "tools/list":
            return None if is_notification else self._result(req_id, {"tools": TOOLS})

        if method == "tools/call":
            if not isinstance(params, dict) or not isinstance(params.get("name"), str):
                return None if is_notification else self._error(req_id, -32602, "Invalid params: missing tool 'name'")
            tool_name = params["name"]
            if tool_name not in TOOL_NAMES:
                return None if is_notification else self._error(req_id, -32602, f"Unknown tool: {tool_name}")
            meta = params.get("_meta")
            progress_token = meta.get("progressToken") if isinstance(meta, dict) else None
            res = _handle_tool_call(
                tool_name,
                params.get("arguments"),
                progress_token=progress_token,
                negotiated_version=self.negotiated_version,
            )
            return None if is_notification else self._result(req_id, res)

        if method == "resources/list":
            return None if is_notification else self._result(req_id, {"resources": RESOURCES})

        if method == "resources/templates/list":
            return None if is_notification else self._result(req_id, {"resourceTemplates": []})

        if method == "resources/read":
            if not isinstance(params, dict) or not isinstance(params.get("uri"), str):
                return None if is_notification else self._error(req_id, -32602, "Invalid params: missing resource 'uri'")
            uri = params["uri"]
            try:
                contents = _read_resource(uri)
            except (RuntimeError, OSError) as exc:
                return None if is_notification else self._error(req_id, -32603, f"Resource read failed: {exc}")
            if contents is None:
                return None if is_notification else self._error(req_id, -32002, f"Resource not found: {uri}", {"uri": uri})
            return None if is_notification else self._result(req_id, {"contents": contents})

        if method == "prompts/list":
            return None if is_notification else self._result(req_id, {"prompts": PROMPTS})

        if method == "prompts/get":
            if not isinstance(params, dict) or not isinstance(params.get("name"), str):
                return None if is_notification else self._error(req_id, -32602, "Invalid params: missing prompt 'name'")
            prompt = _get_prompt(params["name"], params.get("arguments"))
            if prompt is None:
                return None if is_notification else self._error(req_id, -32602, f"Unknown prompt: {params['name']}")
            return None if is_notification else self._result(req_id, prompt)

        if is_notification:
            return None
        return self._error(req_id, -32601, f"Method not found: {method}")

    def serve_stdio(self):
        for raw_line in sys.stdin.buffer:
            line = raw_line.decode("utf-8", errors="replace").strip()
            if not line:
                continue
            try:
                payload = json.loads(line)
            except ValueError as exc:
                _write_jsonrpc(self._error(None, -32700, f"Parse error: {exc}"))
                continue

            if isinstance(payload, list):
                if not payload:
                    _write_jsonrpc(self._error(None, -32600, "Invalid Request: empty batch"))
                    continue
                responses = []
                for item in payload:
                    resp = self.handle_message(item, in_batch=True)
                    if resp is not None:
                        responses.append(resp)
                if responses:
                    _write_jsonrpc(responses)
                continue

            resp = self.handle_message(payload, in_batch=False)
            if resp is not None:
                _write_jsonrpc(resp)


def _handle_signal(signum, _frame):
    _debug(f"received signal {signum}, shutting down")
    _terminate_proc(_ACTIVE_PROC)
    sys.exit(0)


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        sys.stderr.write(
            "Usage: safarium-mcp\n\n"
            "Starts the Safarium Model Context Protocol (MCP) stdio JSON-RPC 2.0 server.\n"
            "Configure in Claude Code, Claude Desktop, Cursor, Gemini CLI, or Codex CLI.\n"
        )
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "--version":
        sys.stdout.write(f"{SERVER_NAME} {SERVER_VERSION}\n")
        return 0

    signal.signal(signal.SIGTERM, _handle_signal)
    signal.signal(signal.SIGINT, _handle_signal)
    MCPServer().serve_stdio()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
