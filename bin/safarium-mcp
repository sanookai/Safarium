                argv.extend(["--bitrate", str(_validate_int(arguments["bitrate"], "bitrate", lo=16000, hi=1024000))])
            if arguments.get("sample_rate") is not None:
                argv.extend(["--sample-rate", str(_validate_int(arguments["sample_rate"], "sample_rate", lo=8000, hi=192000))])
            if arguments.get("channels") is not None:
                argv.extend(["--channels", str(_validate_int(arguments["channels"], "channels", lo=1, hi=16))])
            if overwrite:
                argv.append("--overwrite")
            exe = _require_render_bin()
            res = _run_subprocess(exe, argv, timeout_sec=timeout_sec)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "verify_media":
            ref_path = _validate_path(arguments.get("reference_path"), "reference_path", must_exist=True)
            timeout_sec = _validate_timeout(arguments, 300)
            argv = ["verify", ref_path]
            if arguments.get("candidate_path") is not None:
                cand_path = _validate_path(arguments["candidate_path"], "candidate_path", must_exist=True)
                argv.append(cand_path)
            exe = _require_render_bin()
            res = _run_subprocess(exe, argv, timeout_sec=timeout_sec)
            # verify exit 2 means readable comparison diff JSON (exactMatch: false)
            return _format_subprocess_result(
                name, res, ok_exit_codes=(0, 2), negotiated_version=negotiated_version
            )

        if name == "qa_inspect":
            in_path = _validate_path(arguments.get("input_path"), "input_path", must_exist=True)
            timeout_sec = _validate_timeout(arguments, 300)
            overwrite = _validate_bool(arguments.get("overwrite", False), "overwrite")
            argv = ["forge", "qa", in_path, "--json-errors"]
            if arguments.get("ref_path") is not None:
                rpath = _validate_path(arguments["ref_path"], "ref_path", must_exist=True)
                argv.extend(["--ref", rpath])
            if arguments.get("contact_sheet_path") is not None:
                cpath = _validate_path(
                    arguments["contact_sheet_path"],
                    "contact_sheet_path",
                    must_not_exist=not overwrite,
                    parent_must_exist=True,
                )
                argv.extend(["--contact-sheet", cpath])
            if arguments.get("cols") is not None:
                argv.extend(["--cols", str(_validate_int(arguments["cols"], "cols", lo=1, hi=24))])
            if arguments.get("rows") is not None:
                argv.extend(["--rows", str(_validate_int(arguments["rows"], "rows", lo=1, hi=24))])
            if arguments.get("tile_width") is not None:
                argv.extend(["--tile-width", str(_validate_int(arguments["tile_width"], "tile_width", lo=64, hi=2048))])
            if arguments.get("scene_threshold") is not None:
                argv.extend([
                    "--scene-threshold",
                    str(_validate_number(arguments["scene_threshold"], "scene_threshold", exclusive_lo=0.0, hi=1.0)),
                ])
            if arguments.get("silence_threshold_db") is not None:
                argv.extend([
                    "--silence-threshold-db",
                    str(_validate_number(arguments["silence_threshold_db"], "silence_threshold_db", lo=-120.0, hi=0.0)),
                ])
            if _validate_bool(arguments.get("thai_ocr", False), "thai_ocr"):
                argv.append("--thai-ocr")
            if arguments.get("min_score") is not None:
                argv.extend(["--min-score", str(_validate_number(arguments["min_score"], "min_score", lo=0.0, hi=100.0))])
            if arguments.get("max_de00_p95") is not None:
                argv.extend([
                    "--max-de00-p95",
                    str(_validate_number(arguments["max_de00_p95"], "max_de00_p95", lo=0.0, hi=100.0)),
                ])
            if _validate_bool(arguments.get("strict", False), "strict"):
                argv.append("--strict")
            if overwrite:
                argv.append("--overwrite")
            exe = _require_render_bin()
            res = _run_subprocess(exe, argv, timeout_sec=timeout_sec)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

    except (ValueError, RuntimeError) as exc:
        return _tool_error_result(name, "E_USAGE", str(exc), negotiated_version=negotiated_version)
    except OSError as exc:
        return _tool_error_result(name, "E_IO", str(exc), negotiated_version=negotiated_version)

    return _tool_error_result(name, "E_UNKNOWN_TOOL", f"Unknown tool: {name}", negotiated_version=negotiated_version)


