            exe = _require_render_bin()
            res = _run_subprocess(exe, argv, timeout_sec=timeout_sec)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "transcode_supremacy":
            in_path = _validate_path(arguments.get("input_path"), "input_path", must_exist=True)
            overwrite = _validate_bool(arguments.get("overwrite", False), "overwrite")
            out_path = _validate_path(
                arguments.get("output_path"), "output_path", must_not_exist=not overwrite, parent_must_exist=True
            )
            timeout_sec = _validate_timeout(arguments, 600)
            allowed_scenarios = {
                "youtube", "youtube-4k", "shorts", "tiktok", "reels",
                "web-streaming", "web-compat", "screen-recording",
                "cinema-master", "cinema-vfx", "transparent-vfx",
                "hdr-dolby-vision", "hdr10", "spatial-visionos",
                "archival", "live-low-latency", "podcast-video",
                "webp-clip", "gif-clip",
            }
            allowed_codecs = {
                "h264", "hevc", "hevc-alpha", "hevc-10bit", "hevc-422-10", "hevc-444-10",
                "prores-proxy", "prores-lt", "prores422", "prores422hq", "prores4444", "prores4444xq",
            }
            scenario = None
            if arguments.get("scenario") is not None:
                scenario = _validate_enum(arguments["scenario"], "scenario", allowed_scenarios)
            argv = [
                "forge", "transcode", in_path,
                "--output", out_path,
                "--progress", "jsonl",
                "--json-errors",
            ]
            if scenario is not None:
                argv.extend(["--scenario", scenario])
                if arguments.get("codec") is not None:
                    argv.extend(["--codec", _validate_enum(arguments["codec"], "codec", allowed_codecs)])
                if arguments.get("mode") is not None:
                    argv.extend([
                        "--mode",
                        _validate_enum(arguments["mode"], "mode", {"fast", "balanced", "high-quality", "cqf", "2pass", "mini-cae"}),
                    ])
            else:
                codec = _validate_enum(arguments.get("codec", "hevc-10bit"), "codec", allowed_codecs)
                mode = _validate_enum(
                    arguments.get("mode", "high-quality"),
                    "mode",
                    {"fast", "balanced", "high-quality", "cqf", "2pass", "mini-cae"},
                )
                argv.extend(["--codec", codec, "--mode", mode])
            if _validate_bool(arguments.get("tonemap_sdr", False), "tonemap_sdr"):
                argv.append("--tonemap-sdr")
            if arguments.get("bitrate") is not None:
                argv.extend(["--bitrate", str(_validate_int(arguments["bitrate"], "bitrate", lo=100000))])
            if arguments.get("cqf") is not None:
                argv.extend(["--cqf", str(_validate_number(arguments["cqf"], "cqf", lo=0.0, hi=1.0))])
            if arguments.get("vbv_max_bitrate") is not None:
                argv.extend(["--vbv-max-bitrate", str(_validate_int(arguments["vbv_max_bitrate"], "vbv_max_bitrate", lo=100000))])
            if arguments.get("vbv_buffer_sec") is not None:
                argv.extend(["--vbv-buffer-sec", str(_validate_number(arguments["vbv_buffer_sec"], "vbv_buffer_sec", exclusive_lo=0.0, hi=30.0))])
            if arguments.get("spatial_aq") is not None:
                argv.append("--spatial-aq" if _validate_bool(arguments["spatial_aq"], "spatial_aq") else "--no-spatial-aq")
            if arguments.get("lookahead") is not None:
                argv.extend(["--lookahead", str(_validate_int(arguments["lookahead"], "lookahead", lo=0, hi=60))])
            if arguments.get("engines") is not None:
                argv.extend(["--engines", str(_validate_int(arguments["engines"], "engines", lo=1, hi=4))])
            if _validate_bool(arguments.get("denoise", False), "denoise"):
                argv.append("--denoise")
            if arguments.get("denoise_strength") is not None:
