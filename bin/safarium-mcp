            if overwrite:
                argv.append("--overwrite")
            exe = _require_render_bin()
            res = _run_subprocess(exe, argv, timeout_sec=timeout_sec, progress_token=progress_token)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "list_scenarios":
            exe = _require_render_bin()
            argv = ["forge", "scenarios", "--json-errors"]
            if arguments.get("scenario") is not None:
                sc = arguments["scenario"]
                if not isinstance(sc, str) or not sc.strip():
                    raise ValueError("'scenario' must be a non-empty string")
                argv.extend(["--scenario", sc.strip()])
            res = _run_subprocess(exe, argv, timeout_sec=15)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "package_hls":
            in_path = _validate_path(arguments.get("input_path"), "input_path", must_exist=True)
            out_dir = _validate_path(arguments.get("output_dir"), "output_dir", parent_must_exist=True)
            timeout_sec = _validate_timeout(arguments, 600)
            fmt = _validate_enum(arguments.get("format", "fmp4"), "format", {"fmp4", "ts"})
            codec = _validate_enum(arguments.get("codec", "hevc-10bit"), "codec", {"h264", "hevc", "hevc-10bit"})
            argv = [
                "forge", "hls", in_path,
                "--output", out_dir,
                "--format", fmt,
                "--codec", codec,
                "--json-errors",
            ]
            if arguments.get("segment_sec") is not None:
                argv.extend(["--segment-sec", str(_validate_number(arguments["segment_sec"], "segment_sec", lo=0.5, hi=30.0))])
            if arguments.get("rungs") is not None:
                rungs = arguments["rungs"]
                allowed_rungs = {"360p", "480p", "720p", "1080p", "1440p", "2160p"}
                if not isinstance(rungs, list) or not rungs:
                    raise ValueError("'rungs' must be a non-empty list of rung names")
                cleaned = [_validate_enum(r, "rungs[]", allowed_rungs) for r in rungs]
                argv.extend(["--rungs", ",".join(cleaned)])
            if arguments.get("fps") is not None:
                argv.extend(["--fps", str(_validate_number(arguments["fps"], "fps", exclusive_lo=0.0, hi=120.0))])
            if arguments.get("subtitles_vtt_path") is not None:
                vtt = _validate_path(arguments["subtitles_vtt_path"], "subtitles_vtt_path", must_exist=True)
                argv.extend(["--subtitles", vtt])
            if arguments.get("subtitle_lang") is not None:
                slang = arguments["subtitle_lang"]
                if not isinstance(slang, str) or not slang.strip():
                    raise ValueError("'subtitle_lang' must be a non-empty string")
                argv.extend(["--subtitle-lang", slang.strip()])
            if arguments.get("subtitle_name") is not None:
                sname = arguments["subtitle_name"]
                if not isinstance(sname, str) or not sname.strip():
                    raise ValueError("'subtitle_name' must be a non-empty string")
                argv.extend(["--subtitle-name", sname.strip()])
            exe = _require_render_bin()
            res = _run_subprocess(exe, argv, timeout_sec=timeout_sec)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "export_animated_clip":
            in_path = _validate_path(arguments.get("input_path"), "input_path", must_exist=True)
            overwrite = _validate_bool(arguments.get("overwrite", False), "overwrite")
            out_path = _validate_path(
                arguments.get("output_path"), "output_path", must_not_exist=not overwrite, parent_must_exist=True
            )
            timeout_sec = _validate_timeout(arguments, 300)
            argv = [
                "forge", "clip", in_path,
                "--output", out_path,
                "--json-errors",
            ]
            if arguments.get("format") is not None:
                argv.extend(["--format", _validate_enum(arguments["format"], "format", {"webp", "gif", "apng"})])
            if arguments.get("fps") is not None:
                argv.extend(["--fps", str(_validate_number(arguments["fps"], "fps", exclusive_lo=0.0, hi=60.0))])
            if arguments.get("max_width") is not None:
                argv.extend(["--max-width", str(_validate_int(arguments["max_width"], "max_width", lo=16, hi=2048))])
            if arguments.get("max_duration") is not None:
                argv.extend(["--max-duration", str(_validate_number(arguments["max_duration"], "max_duration", exclusive_lo=0.0, hi=120.0))])
            if overwrite:
                argv.append("--overwrite")
            exe = _require_render_bin()
            res = _run_subprocess(exe, argv, timeout_sec=timeout_sec)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "audio_encode":
            in_path = _validate_path(arguments.get("input_path"), "input_path", must_exist=True)
            overwrite = _validate_bool(arguments.get("overwrite", False), "overwrite")
            out_path = _validate_path(
                arguments.get("output_path"), "output_path", must_not_exist=not overwrite, parent_must_exist=True
            )
            timeout_sec = _validate_timeout(arguments, 300)
            acodec = _validate_enum(
                arguments.get("codec", "aac-max"),
                "codec",
                {"aac-max", "he-aac", "he-aac-v2", "alac", "opus", "apac", "pcm16", "pcm24", "pcm32f"},
            )
            argv = [
