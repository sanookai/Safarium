#!/usr/bin/python3 -ISB
"""Zero-dependency Model Context Protocol (MCP) stdio JSON-RPC 2.0 server for Safarium.

Exposes Safarium's native macOS Apple Silicon rendering, media DAG, QA, verification,
and 2D raster capabilities to any MCP-compatible AI agent (Claude Code, Claude Desktop,
Cursor, Gemini CLI, Codex CLI, etc.) while strictly honoring the SF-VIDEO-1 single-slot
FIFO queue and Apple-only system-framework invariants.
"""

from collections import deque
import json
import os
import select
import signal
import stat
import subprocess
import sys
import tempfile
import time


SERVER_NAME = "safarium-mcp"
SERVER_VERSION = "1.0.0"
SUPPORTED_VERSIONS = ("2025-06-18", "2025-03-26", "2024-11-05")
DEFAULT_NEGOTIATED_VERSION = "2025-03-26"

MAX_STDOUT_BYTES = 4 * 1024 * 1024
MAX_STDERR_LINES = 60
MAX_TIMEOUT_SEC = 1800
MIN_TIMEOUT_SEC = 5
MAX_DIM = 8192
MAX_PIXELS = 33_554_432

SERVER_INSTRUCTIONS = (
    "Safarium is a native macOS Apple Silicon HTML, 3D, 2D Raster, and Media Rendering Engine "
    "(0% external video/browser/CV binaries). Read-only inspection tools (doctor, status, "
    "capabilities, raster_info, forge_schema, forge_validate, probe_media, cache_stats) bypass "
    "the queue and return immediately. Heavy render/verify/QA tools automatically serialize "
    "through the per-user SF-VIDEO-1 FIFO queue. Always run doctor and forge_validate before "
    "heavy renders, and verify outputs with verify_media or qa_inspect."
)

# Active child subprocess reference for clean signal shutdown.
_ACTIVE_PROC = None


def _debug(msg):
    if os.environ.get("SAFARIUM_MCP_DEBUG"):
        try:
            sys.stderr.write(f"[safarium-mcp] {msg}\n")
            sys.stderr.flush()
        except OSError:
            pass


def _bin_dirs():
    dirs = []
    for raw in (os.path.realpath(__file__), os.path.abspath(__file__)):
        d = os.path.dirname(raw)
        if d and d not in dirs:
            dirs.append(d)
    return dirs


def _trusted_sibling(name):
    uid = os.getuid()
    for d in _bin_dirs():
        candidate = os.path.join(d, name)
        try:
            st = os.lstat(candidate)
        except OSError:
            continue
        if stat.S_ISREG(st.st_mode) and st.st_uid in (0, uid) and not (st.st_mode & 0o022):
            if os.access(candidate, os.X_OK):
                return candidate
    return None


def _share_doc_path(filename):
    for d in _bin_dirs():
        share = os.path.normpath(os.path.join(d, "..", "share", "safarium", filename))
        if os.path.isfile(share) and not os.path.islink(share):
            return share
        repo_doc = os.path.normpath(os.path.join(d, "..", "docs", filename))
        if os.path.isfile(repo_doc) and not os.path.islink(repo_doc):
            return repo_doc
    return None


def _validate_path(raw, field_name, *, must_exist=False, must_be_dir=False, must_not_exist=False, parent_must_exist=False):
    if not isinstance(raw, str) or not raw.strip():
        raise ValueError(f"'{field_name}' must be a non-empty string path")
    if "\x00" in raw or "\n" in raw or "\r" in raw:
        raise ValueError(f"'{field_name}' contains invalid control characters")
    path = os.path.abspath(os.path.expanduser(raw))
    if os.path.basename(path).startswith("._"):
        raise ValueError(f"'{field_name}' must not target AppleDouble sidecar file: {path}")
    if must_exist:
        if must_be_dir:
            if not os.path.isdir(path):
                raise ValueError(f"'{field_name}' directory does not exist: {path}")
        else:
            if not os.path.isfile(path):
                raise ValueError(f"'{field_name}' file does not exist: {path}")
    if must_not_exist and os.path.lexists(path):
        raise ValueError(f"'{field_name}' already exists (refusing overwrite): {path}")
    if parent_must_exist:
        parent = os.path.dirname(path)
        if not parent or not os.path.isdir(parent):
            raise ValueError(f"parent directory for '{field_name}' does not exist: {parent}")
    return path


def _validate_int(val, field_name, *, lo=None, hi=None, even=False):
    if isinstance(val, bool) or not isinstance(val, int):
        raise ValueError(f"'{field_name}' must be an integer")
    if lo is not None and val < lo:
        raise ValueError(f"'{field_name}' must be >= {lo}")
    if hi is not None and val > hi:
        raise ValueError(f"'{field_name}' must be <= {hi}")
    if even and (val % 2 != 0):
        raise ValueError(f"'{field_name}' must be an even integer")
    return val


def _validate_number(val, field_name, *, lo=None, hi=None, exclusive_lo=None):
    if isinstance(val, bool) or not isinstance(val, (int, float)):
        raise ValueError(f"'{field_name}' must be a number")
    f = float(val)
    if lo is not None and f < lo:
        raise ValueError(f"'{field_name}' must be >= {lo}")
    if exclusive_lo is not None and f <= exclusive_lo:
        raise ValueError(f"'{field_name}' must be > {exclusive_lo}")
    if hi is not None and f > hi:
        raise ValueError(f"'{field_name}' must be <= {hi}")
    return f


def _validate_bool(val, field_name):
    if not isinstance(val, bool):
        raise ValueError(f"'{field_name}' must be a boolean")
    return val


def _validate_enum(val, field_name, allowed):
    if not isinstance(val, str) or val not in allowed:
        raise ValueError(f"'{field_name}' must be one of {sorted(allowed)}")
    return val


def _validate_timeout(args, default_sec):
    if "timeout_sec" not in args or args["timeout_sec"] is None:
        return default_sec
    return _validate_int(args["timeout_sec"], "timeout_sec", lo=MIN_TIMEOUT_SEC, hi=MAX_TIMEOUT_SEC)


def _try_parse_json(text):
    s = text.strip()
    if not s:
        return None
    try:
        return json.loads(s)
    except (ValueError, TypeError):
        pass
    # Fallback: scan last non-empty line in case of trailing summary JSON.
    lines = [ln.strip() for ln in s.splitlines() if ln.strip()]
    for ln in reversed(lines):
        if ln.startswith("{") and ln.endswith("}"):
            try:
                return json.loads(ln)
            except (ValueError, TypeError):
                continue
    return None


def _extract_error_envelope(stderr_lines):
    for ln in reversed(stderr_lines):
        s = ln.strip()
        if s.startswith("{") and s.endswith("}"):
            try:
                obj = json.loads(s)
                if isinstance(obj, dict) and obj.get("ok") is False and isinstance(obj.get("error"), dict):
                    return obj
            except (ValueError, TypeError):
                continue
    return None


def _write_jsonrpc(obj):
    line = json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n"
    sys.stdout.buffer.write(line.encode("utf-8"))
    sys.stdout.buffer.flush()


def _emit_progress(progress_token, event):
    if progress_token is None or not isinstance(event, dict):
        return
    progress = event.get("frame", event.get("progress", event.get("completed")))
    total = event.get("totalFrames", event.get("total"))
    if not isinstance(progress, (int, float)):
        return
    params = {
        "progressToken": progress_token,
        "progress": progress,
    }
    if isinstance(total, (int, float)) and total > 0:
        params["total"] = total
    stage = event.get("stage") or event.get("event") or event.get("phase")
    if isinstance(stage, str) and stage:
        params["message"] = stage
    _write_jsonrpc({
        "jsonrpc": "2.0",
        "method": "notifications/progress",
        "params": params,
    })


def _terminate_proc(proc):
    if proc is None or proc.poll() is not None:
        return
    try:
        proc.terminate()
    except OSError:
        return
    deadline = time.monotonic() + 5.0
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            return
        time.sleep(0.05)
    try:
        proc.kill()
        proc.wait(timeout=2.0)
    except (OSError, subprocess.SubprocessError):
        pass


def _run_subprocess(
    exe,
    argv,
    *,
    timeout_sec,
    stdin_bytes=None,
    progress_token=None,
):
    global _ACTIVE_PROC
    env = dict(os.environ)
    env["SAFARIUM_JSON_ERRORS"] = "1"

    stdin_mode = subprocess.PIPE if stdin_bytes is not None else subprocess.DEVNULL
    proc = subprocess.Popen(
        [exe, *argv],
        stdin=stdin_mode,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        shell=False,
    )
    _ACTIVE_PROC = proc

    stdout_chunks = []
    stdout_size = 0
    stdout_truncated = False
    stderr_lines = deque(maxlen=MAX_STDERR_LINES)
    stderr_buf = b""
    last_progress = None
    timed_out = False

    try:
        if stdin_bytes is not None and proc.stdin is not None:
            try:
                proc.stdin.write(stdin_bytes)
                proc.stdin.flush()
            except BrokenPipeError:
                pass
            finally:
                try:
                    proc.stdin.close()
                except OSError:
                    pass

        assert proc.stdout is not None and proc.stderr is not None
        os.set_blocking(proc.stdout.fileno(), False)
        os.set_blocking(proc.stderr.fileno(), False)

        open_fds = {proc.stdout.fileno(): "stdout", proc.stderr.fileno(): "stderr"}
        deadline = time.monotonic() + timeout_sec

        while open_fds:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                _terminate_proc(proc)
                break
            rlist, _, _ = select.select(list(open_fds.keys()), [], [], min(0.25, remaining))
            for fd in rlist:
                kind = open_fds[fd]
                try:
                    chunk = os.read(fd, 65536)
                except BlockingIOError:
                    continue
                except OSError:
                    chunk = b""
                if not chunk:
                    del open_fds[fd]
                    continue
                if kind == "stdout":
                    if stdout_size < MAX_STDOUT_BYTES:
                        take = min(len(chunk), MAX_STDOUT_BYTES - stdout_size)
                        stdout_chunks.append(chunk[:take])
                        stdout_size += take
                        if take < len(chunk):
                            stdout_truncated = True
                    else:
                        stdout_truncated = True
                else:
                    stderr_buf += chunk
                    while b"\n" in stderr_buf:
                        line_b, stderr_buf = stderr_buf.split(b"\n", 1)
                        line_s = line_b.decode("utf-8", errors="replace")
                        stderr_lines.append(line_s)
                        s = line_s.strip()
                        if s.startswith("{") and s.endswith("}"):
                            try:
                                ev = json.loads(s)
                                if isinstance(ev, dict) and (
                                    "progress" in ev or "frame" in ev or ev.get("event") == "progress"
                                ):
                                    last_progress = ev
                                    _emit_progress(progress_token, ev)
                            except (ValueError, TypeError):
                                pass

        if stderr_buf:
            stderr_lines.append(stderr_buf.decode("utf-8", errors="replace"))

        if not timed_out:
            rem = max(0.5, deadline - time.monotonic())
            try:
                proc.wait(timeout=rem)
            except subprocess.TimeoutExpired:
                timed_out = True
                _terminate_proc(proc)
    finally:
        for stream in (proc.stdout, proc.stderr):
            if stream is not None:
                try:
                    stream.close()
                except OSError:
                    pass
        _ACTIVE_PROC = None

    stdout_text = b"".join(stdout_chunks).decode("utf-8", errors="replace")
    return {
        "returncode": proc.returncode,
        "stdout": stdout_text,
        "stdout_truncated": stdout_truncated,
        "stderr_lines": list(stderr_lines),
        "last_progress": last_progress,
        "timed_out": timed_out,
    }


def _tool_error_result(tool_name, code, message, *, hint=None, details=None, negotiated_version=DEFAULT_NEGOTIATED_VERSION):
    payload = {
        "ok": False,
        "tool": tool_name,
        "error": {
            "code": code,
            "message": message,
        },
    }
    if hint:
        payload["error"]["hint"] = hint
    if details is not None:
        payload["details"] = details
    result = {
        "content": [{"type": "text", "text": json.dumps(payload, ensure_ascii=False, indent=2)}],
        "isError": True,
    }
    if negotiated_version >= "2025-06-18":
        result["structuredContent"] = payload
    return result


def _tool_ok_result(payload, *, negotiated_version=DEFAULT_NEGOTIATED_VERSION):
    if isinstance(payload, dict):
        text = json.dumps(payload, ensure_ascii=False, indent=2)
        structured = payload
    else:
        text = json.dumps({"result": payload}, ensure_ascii=False, indent=2)
        structured = {"result": payload}
    result = {
        "content": [{"type": "text", "text": text}],
        "isError": False,
    }
    if negotiated_version >= "2025-06-18":
        result["structuredContent"] = structured
    return result


def _format_subprocess_result(tool_name, res, *, ok_exit_codes=(0,), negotiated_version=DEFAULT_NEGOTIATED_VERSION):
    if res["timed_out"]:
        return _tool_error_result(
            tool_name,
            "E_TIMEOUT",
            f"Safarium tool '{tool_name}' exceeded its timeout and was terminated cleanly.",
            hint="Increase timeout_sec (up to 1800) or inspect queue wait via status.",
            details={
                "last_progress": res["last_progress"],
                "stderr_tail": res["stderr_lines"][-10:],
            },
            negotiated_version=negotiated_version,
        )

    parsed = _try_parse_json(res["stdout"])
    if res["returncode"] in ok_exit_codes:
        if isinstance(parsed, dict):
            if res["stdout_truncated"]:
                parsed["_truncated"] = True
            return _tool_ok_result(parsed, negotiated_version=negotiated_version)
        return _tool_ok_result(
            {
                "ok": True,
                "returncode": res["returncode"],
                "output": res["stdout"].strip(),
                "truncated": res["stdout_truncated"],
            },
            negotiated_version=negotiated_version,
        )

    env_err = _extract_error_envelope(res["stderr_lines"])
    if env_err is not None:
        result = {
            "content": [{"type": "text", "text": json.dumps(env_err, ensure_ascii=False, indent=2)}],
            "isError": True,
        }
        if negotiated_version >= "2025-06-18":
            result["structuredContent"] = env_err
        return result

    return _tool_error_result(
        tool_name,
        "E_WORKER_FAILED",
        f"Safarium command exited with code {res['returncode']}.",
        details={
            "returncode": res["returncode"],
            "stdout_parsed": parsed,
            "stdout_tail": res["stdout"][-2000:] if parsed is None else None,
            "stderr_tail": res["stderr_lines"][-20:],
            "last_progress": res["last_progress"],
        },
        negotiated_version=negotiated_version,
    )


