TOOL_NAMES = {t["name"] for t in TOOLS}


def _require_render_bin():
    exe = _trusted_sibling("safarium-render")
    if exe is None:
        raise RuntimeError(
            f"missing or untrusted sibling 'safarium-render' beside {os.path.dirname(os.path.abspath(__file__))}"
        )
    return exe


def _require_safarium_bin():
    exe = _trusted_sibling("safarium")
    if exe is None:
        raise RuntimeError(
            f"missing or untrusted sibling 'safarium' beside {os.path.dirname(os.path.abspath(__file__))}"
        )
    return exe


def _handle_tool_call(name, arguments, *, progress_token=None, negotiated_version=DEFAULT_NEGOTIATED_VERSION):
    if arguments is None:
        arguments = {}
    if not isinstance(arguments, dict):
        return _tool_error_result(
            name, "E_USAGE", "Tool arguments must be a JSON object.", negotiated_version=negotiated_version
        )

    try:
        if name == "doctor":
            exe = _require_render_bin()
            res = _run_subprocess(exe, ["doctor", "--json"], timeout_sec=20)
            return _format_subprocess_result(
                name, res, ok_exit_codes=(0, 1), negotiated_version=negotiated_version
            )

        if name == "status":
            detail = _validate_bool(arguments.get("detail", True), "detail")
            exe = _require_render_bin()
            argv = ["status", "--json-detail"] if detail else ["status"]
            res = _run_subprocess(exe, argv, timeout_sec=10)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "capabilities":
            fast = _validate_bool(arguments.get("fast", False), "fast")
            exe = _require_render_bin()
            argv = ["forge", "capabilities", "--fast"] if fast else ["capabilities"]
            res = _run_subprocess(exe, argv, timeout_sec=15)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "raster_info":
            exe = _require_safarium_bin()
            res = _run_subprocess(exe, ["raster", "info", "--json"], timeout_sec=15)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "forge_schema":
            target = _validate_enum(
                arguments.get("target", "all"), "target", {"all", "recipe", "subcommands", "errors"}
            )
            exe = _require_render_bin()
            res = _run_subprocess(exe, ["schema", target], timeout_sec=15)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "forge_validate":
            has_path = "recipe_path" in arguments and arguments["recipe_path"] is not None
            has_obj = "recipe" in arguments and arguments["recipe"] is not None
            if has_path == has_obj:
                raise ValueError("provide exactly one of 'recipe_path' or 'recipe'")
            dry_run = _validate_bool(arguments.get("dry_run", False), "dry_run")
            exe = _require_render_bin()

            if has_path:
                rpath = _validate_path(arguments["recipe_path"], "recipe_path", must_exist=True)
                argv = (
                    ["forge", "run", "--recipe", rpath, "--dry-run", "--json-errors"]
                    if dry_run
                    else ["forge", "validate", "--recipe", rpath, "--json-errors"]
                )
                res = _run_subprocess(exe, argv, timeout_sec=20)
                return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

            recipe_obj = arguments["recipe"]
            if not isinstance(recipe_obj, dict):
                raise ValueError("'recipe' must be a JSON object")
            recipe_bytes = json.dumps(recipe_obj, ensure_ascii=False).encode("utf-8")
            if dry_run:
                tmp_path = None
                try:
                    with tempfile.NamedTemporaryFile(
                        prefix="safarium-mcp-recipe-", suffix=".json", delete=False
                    ) as tf:
                        tf.write(recipe_bytes)
                        tmp_path = tf.name
                    res = _run_subprocess(
                        exe, ["forge", "run", "--recipe", tmp_path, "--dry-run", "--json-errors"], timeout_sec=20
                    )
                    return _format_subprocess_result(name, res, negotiated_version=negotiated_version)
                finally:
                    if tmp_path:
                        try:
                            os.unlink(tmp_path)
                        except OSError:
                            pass
            res = _run_subprocess(
                exe,
                ["forge", "validate", "--recipe", "-", "--json-errors"],
                timeout_sec=20,
                stdin_bytes=recipe_bytes,
            )
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "probe_media":
            mpath = _validate_path(arguments.get("path"), "path", must_exist=True)
            include_pkts = _validate_bool(arguments.get("include_audio_packets", False), "include_audio_packets")
            exe = _require_render_bin()
            argv = ["forge", "inspect", mpath]
            if include_pkts:
                argv.append("--include-audio-packets")
            res = _run_subprocess(exe, argv, timeout_sec=30)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "cache_stats":
            kind = _validate_enum(arguments.get("kind", "auto"), "kind", {"auto", "scene", "shot"})
            exe = _require_render_bin()
            argv = ["forge", "cache", "stats", "--kind", kind]
            if arguments.get("root") is not None:
                root_dir = _validate_path(arguments["root"], "root", must_exist=True, must_be_dir=True)
                argv.extend(["--root", root_dir])
            res = _run_subprocess(exe, argv, timeout_sec=15)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "forge_run":
            rpath = _validate_path(arguments.get("recipe_path"), "recipe_path", must_exist=True)
            dry_run = _validate_bool(arguments.get("dry_run", False), "dry_run")
            validate_only = _validate_bool(arguments.get("validate_only", False), "validate_only")
            timeout_sec = _validate_timeout(arguments, 600)
            exe = _require_render_bin()
            argv = ["forge", "run", "--recipe", rpath, "--progress", "jsonl", "--json-errors"]
            if dry_run:
                argv.append("--dry-run")
            if validate_only:
                argv.append("--validate-only")
            res = _run_subprocess(exe, argv, timeout_sec=timeout_sec, progress_token=progress_token)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "html_render":
            input_html = _validate_path(arguments.get("input_html"), "input_html", must_exist=True)
            output_path = _validate_path(
                arguments.get("output_path"), "output_path", must_not_exist=True, parent_must_exist=True
            )
            width = _validate_int(arguments.get("width"), "width", lo=2, hi=MAX_DIM, even=True)
            height = _validate_int(arguments.get("height"), "height", lo=2, hi=MAX_DIM, even=True)
            if width * height > MAX_PIXELS:
                raise ValueError(f"width*height ({width * height}) exceeds pixel budget {MAX_PIXELS}")
            fps = _validate_int(arguments.get("fps"), "fps", lo=1, hi=240)
            frames = _validate_int(arguments.get("frames"), "frames", lo=1)
            timeout_sec = _validate_timeout(arguments, 600)

            video_only = _validate_bool(arguments.get("video_only", False), "video_only")
            has_audio = arguments.get("audio_path") is not None
            if video_only == has_audio:
                raise ValueError("specify exactly one of 'video_only: true' or 'audio_path'")

            if arguments.get("bitrate") is not None and arguments.get("quality") is not None:
                raise ValueError("'bitrate' and 'quality' are mutually exclusive")
            if arguments.get("cqf") is not None and (arguments.get("bitrate") is not None or arguments.get("quality") is not None):
                raise ValueError("'cqf' is mutually exclusive with 'bitrate' and 'quality'")

            allowed_codecs = {
                "h264", "hevc", "hevc-alpha", "hevc-10bit", "hevc-422-10", "hevc-444-10",
                "prores-proxy", "prores-lt", "prores422", "prores422hq", "prores4444", "prores4444xq",
            }
            mov_only_codecs = {
                "hevc-alpha", "prores-proxy", "prores-lt", "prores422", "prores422hq", "prores4444", "prores4444xq",
            }
            codec = None
            if arguments.get("codec") is not None:
                codec = _validate_enum(arguments["codec"], "codec", allowed_codecs)
                ext = os.path.splitext(output_path)[1].lower()
                if codec in mov_only_codecs and ext != ".mov":
                    raise ValueError(f"codec '{codec}' requires a '.mov' output_path")

            argv = [
                "html",
                input_html,
                "--output",
                output_path,
                "--width",
                str(width),
                "--height",
                str(height),
                "--fps",
                str(fps),
                "--frames",
                str(frames),
                "--json",
                "--progress",
                "jsonl",
                "--json-errors",
            ]
            if arguments.get("start") is not None:
                argv.extend(["--start", str(_validate_number(arguments["start"], "start", lo=0.0))])
            if codec is not None:
                argv.extend(["--codec", codec])
            if arguments.get("bitrate") is not None:
                argv.extend(["--bitrate", str(_validate_int(arguments["bitrate"], "bitrate", lo=100000))])
            if arguments.get("quality") is not None:
                argv.extend(["--quality", str(_validate_number(arguments["quality"], "quality", lo=0.0, hi=1.0))])
            if arguments.get("cqf") is not None:
                argv.extend(["--cqf", str(_validate_number(arguments["cqf"], "cqf", lo=0.0, hi=1.0))])
            if _validate_bool(arguments.get("spatial_aq", False), "spatial_aq"):
                argv.append("--spatial-aq")
            if _validate_bool(arguments.get("high_quality", False), "high_quality"):
                argv.append("--high-quality")
            if arguments.get("hdr") is not None:
                hdr = _validate_enum(arguments["hdr"], "hdr", {"sdr", "hdr10", "hlg", "dv84", "apple-log", "apple-log2"})
                argv.extend(["--hdr", hdr])
            if _validate_bool(arguments.get("transparent", False), "transparent"):
                argv.append("--transparent")
            if arguments.get("pixel_format") is not None:
                pf = _validate_enum(arguments["pixel_format"], "pixel_format", {"bgra", "nv12-vimage", "nv12-left", "p010", "p210", "p410"})
                argv.extend(["--pixel-format", pf])
            if arguments.get("snapshot_quality") is not None:
                sq = _validate_enum(arguments["snapshot_quality"], "snapshot_quality", {"fast", "sharp"})
                argv.extend(["--snapshot-quality", sq])
            if video_only:
                argv.append("--video-only")
            else:
                apath = _validate_path(arguments["audio_path"], "audio_path", must_exist=True)
                argv.extend(["--audio", apath])
                if arguments.get("audio_start") is not None:
                    argv.extend(["--audio-start", str(_validate_number(arguments["audio_start"], "audio_start", lo=0.0))])
            if arguments.get("subtitles_path") is not None:
                spath = _validate_path(arguments["subtitles_path"], "subtitles_path", must_exist=True)
                argv.extend(["--subtitles", spath])
                if arguments.get("subtitle_lang") is not None:
                    slang = arguments["subtitle_lang"]
                    if not isinstance(slang, str) or not (2 <= len(slang) <= 3) or not slang.isalpha():
                        raise ValueError("'subtitle_lang' must be a 2-3 letter ISO language code")
                    argv.extend(["--subtitle-lang", slang.lower()])
            if _validate_bool(arguments.get("hash_frames", False), "hash_frames"):
                argv.append("--hash")
            if _validate_bool(arguments.get("low_ram", False), "low_ram"):
                argv.append("--low-ram")

            exe = _require_render_bin()
            res = _run_subprocess(exe, argv, timeout_sec=timeout_sec, progress_token=progress_token)
            return _format_subprocess_result(name, res, negotiated_version=negotiated_version)

        if name == "analyze_shots":
            in_path = _validate_path(arguments.get("input_path"), "input_path", must_exist=True)
            timeout_sec = _validate_timeout(arguments, 180)
            argv = ["forge", "analyze-shots", in_path, "--json-errors"]
            if arguments.get("scene_threshold") is not None:
                argv.extend([
                    "--scene-threshold",
                    str(_validate_number(arguments["scene_threshold"], "scene_threshold", exclusive_lo=0.0, hi=1.0)),
                ])
            if arguments.get("sample_fps") is not None:
                argv.extend([
                    "--sample-fps",
